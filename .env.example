# Copia este fichero a ".env" (no se sube al repositorio) para que docker compose use una
# base de datos externa en vez del H2 del volumen. Después: docker compose up -d --build

# "local" = H2 dentro del volumen misterio-datos; "nube" = la base externa de abajo
PERFIL=nube

# Prisma Postgres, Neon o cualquier Postgres (el driver se elige por la URL).
# En Prisma: Console → tu proyecto → "Connect to your database" → conexión directa (TCP).
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_USER=usuario
DB_PASSWORD=contraseña

# Clave para crear partidas (cabecera X-Admin-Key). Cámbiala fuera de tu PC.
ADMIN_KEY=cambia-esta-clave
